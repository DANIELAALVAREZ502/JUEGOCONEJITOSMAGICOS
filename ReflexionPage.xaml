<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JUEGOCONEJITOSMAGICOS.ReflexionPage"
             BackgroundImageSource="bosque_noche.jpg"
             Title="Reflexion">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" VerticalOptions="Center">

            <Label Text="Mensaje del Sabio Buho" Style="{StaticResource Titulo}" />

            <!-- Mensaje final de reflexion -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="12">
                    <Image Source="buho.png" HeightRequest="130" HorizontalOptions="Center" />
                    <Label Text="Practicar buenos valores nos convierte en mejores personas cada dia. Se amable, agradece, respeta y comparte."
                           Style="{StaticResource TextoClaro}" FontAttributes="Italic" />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Escuchar" Style="{StaticResource BotonMenta}" Clicked="OnNarrarClicked" />
                <Button Text="Detener" Style="{StaticResource BotonRojo}" Clicked="OnStopClicked" />
            </HorizontalStackLayout>

            <Button Text="Ver lecciones aprendidas" Style="{StaticResource BotonCielo}" Clicked="OnAprenderClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
