<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JUEGOCONEJITOSMAGICOS.MusicaPage"
             BackgroundImageSource="bosque_noche.jpg"
             Title="Ajustes de Sonido">

    <VerticalStackLayout Padding="20" Spacing="16" VerticalOptions="Center">

        <Label Text="Ajustes de Sonido" Style="{StaticResource Titulo}" />

        <!-- Control de musica de fondo -->
        <Border Style="{StaticResource Tarjeta}">
            <VerticalStackLayout Spacing="12">
                <Label Text="Musica de fondo" TextColor="{StaticResource MagicGold}" FontAttributes="Bold"
                       HorizontalOptions="Center" FontSize="18" />
                <Label x:Name="EstadoMusica" Text="Musica: Activada" Style="{StaticResource TextoClaro}" />
                <Button x:Name="BtnMusica" Text="Silenciar" Style="{StaticResource BotonRojo}"
                        Clicked="OnToggleMusicaClicked" />
                <Label Text="Volumen" TextColor="White" HorizontalOptions="Center" />
                <Slider x:Name="SliderVolumen" Minimum="0" Maximum="1" Value="0.3"
                        ValueChanged="OnVolumenCambiado" />
            </VerticalStackLayout>
        </Border>

        <Image Source="mariposas1.png" HeightRequest="110" HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>
