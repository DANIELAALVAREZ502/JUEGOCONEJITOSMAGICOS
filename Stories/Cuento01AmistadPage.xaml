<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JUEGOCONEJITOSMAGICOS.Stories.Cuento01AmistadPage"
             BackgroundImageSource="bosque_noche.jpg"
             Title="El Bosque de la Amistad">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="El Bosque de la Amistad" Style="{StaticResource Titulo}" />

            <!-- Cuento 1: Nala y Tambor -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="12">
                    <Image Source="nala2.png" HeightRequest="150" HorizontalOptions="Center" />
                    <Label Text="Una tarde, Nala encontro un sendero lleno de flores brillantes. Tambor, su mejor amigo, tenia miedo de cruzar el rio. Nala lo tomo de la mano y le dijo: Juntos podemos con todo. Atravesaron el bosque cantando y demostraron que la amistad hace mas liviano cualquier camino."
                           Style="{StaticResource TextoClaro}" />
                    <Label Text="Valor aprendido: la amistad nos fortalece."
                           TextColor="{StaticResource MagicGold}" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Controles de narracion por voz -->
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Escuchar" Style="{StaticResource BotonMenta}" Clicked="OnNarrarClicked" />
                <Button Text="Detener" Style="{StaticResource BotonRojo}" Clicked="OnStopClicked" />
            </HorizontalStackLayout>

            <Button Text="Reflexionar" Style="{StaticResource BotonRosa}" Clicked="OnReflexionarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
