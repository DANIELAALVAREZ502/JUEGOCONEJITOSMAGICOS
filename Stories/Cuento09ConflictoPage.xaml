<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JUEGOCONEJITOSMAGICOS.Stories.Cuento09ConflictoPage"
             BackgroundImageSource="bosque_noche.jpg"
             Title="Resolviendo un Conflicto">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Resolviendo un Conflicto" Style="{StaticResource Titulo}" />

            <!-- Cuento 9: resolver conflictos -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="12">
                    <Image Source="buho.png" HeightRequest="150" HorizontalOptions="Center" />
                    <Label Text="Dos amiguitos del bosque querian el mismo juguete y empezaron a discutir. Tambor les propuso hablar con calma y encontrar una solucion juntos. Descubrieron que hablando con respeto todos pueden estar contentos."
                           Style="{StaticResource TextoClaro}" />
                    <Label Text="Valor aprendido: dialogar con respeto resuelve los conflictos."
                           TextColor="{StaticResource MagicGold}" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Controles de narracion por voz -->
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Escuchar" Style="{StaticResource BotonMenta}" Clicked="OnNarrarClicked" />
                <Button Text="Detener" Style="{StaticResource BotonRojo}" Clicked="OnStopClicked" />
            </HorizontalStackLayout>

            <Button Text="Reflexionar" Style="{StaticResource BotonRosa}" Clicked="OnReflexionarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
