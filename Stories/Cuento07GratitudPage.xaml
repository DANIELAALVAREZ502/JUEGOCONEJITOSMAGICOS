<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JUEGOCONEJITOSMAGICOS.Stories.Cuento07GratitudPage"
             BackgroundImageSource="bosque_noche.jpg"
             Title="Semillitas de Gratitud">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Semillitas de Gratitud" Style="{StaticResource Titulo}" />

            <!-- Cuento 7: la gratitud -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="12">
                    <Image Source="mila.png" HeightRequest="150" HorizontalOptions="Center" />
                    <Label Text="Mila aprendio a dar las gracias por las pequenas cosas: el sol, las flores y la compania de sus amigos. Cada noche pensaba en algo bueno del dia. Descubrio que la gratitud llena el corazon de alegria."
                           Style="{StaticResource TextoClaro}" />
                    <Label Text="Valor aprendido: agradecer nos hace felices."
                           TextColor="{StaticResource MagicGold}" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Controles de narracion por voz -->
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Escuchar" Style="{StaticResource BotonMenta}" Clicked="OnNarrarClicked" />
                <Button Text="Detener" Style="{StaticResource BotonRojo}" Clicked="OnStopClicked" />
            </HorizontalStackLayout>

            <Button Text="Reflexionar" Style="{StaticResource BotonRosa}" Clicked="OnReflexionarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
